# fatal-pulse environment configuration template
# Copy to `.env` and fill in your own values. NEVER commit `.env` or display it on OBS.

# Phase 1 — YouTube Data API v3 (sent strictly via X-Goog-Api-Key header, never in URL query params)
YOUTUBE_API_KEY=your_youtube_data_api_v3_key_here

# Local SQLite database path (WAL mode enabled automatically)
FPULSE_DB_PATH=./fatal_pulse.db

# Optional path to yt-dlp binary for TikTok public metadata polling
YTDLP_BIN=yt-dlp

# Default polling interval in seconds for live TUI mode
FPULSE_POLL_INTERVAL_SEC=300

# Phase 2 — Instagram Graph API v22+ (Reels insights: views, reach, ig_reels_avg_watch_time, reels_skip_rate)
IG_ACCESS_TOKEN=
IG_USER_ID=

# Phase 2 — YouTube Analytics API v2 (OAuth2 client config path for daily SHORTS_FEED backfill)
YT_OAUTH_CLIENT_JSON=
